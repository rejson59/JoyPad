{
  "name": "joypad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "selftest:relay": "esbuild scripts/relay-selftest.ts --bundle --format=esm --platform=node --outfile=.cache/relay-selftest.mjs --log-level=warning && node .cache/relay-selftest.mjs",
    "selftest:arcade": "esbuild scripts/arcade-selftest.ts --bundle --format=esm --platform=node --define:import.meta.env={} --outfile=.cache/arcade-selftest.mjs --log-level=warning && node .cache/arcade-selftest.mjs",
    "selftest:console": "esbuild scripts/console-selftest.ts --bundle --format=esm --platform=node --define:import.meta.env={} --outfile=.cache/console-selftest.mjs --log-level=warning && node .cache/console-selftest.mjs"
  },
  "dependencies": {
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.47.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "7.3.2"
  }
}
